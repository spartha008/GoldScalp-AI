# GoldScalp AI settings. Copy to .env (which is gitignored) and edit.
# Every variable starts with GOLDSCALP_. A misspelt GOLDSCALP_ variable stops the app on purpose.
# Educational paper trading only: nothing here connects to a broker or places real orders.

# --- Server -------------------------------------------------------------------
# Keep 127.0.0.1: the app is meant for this computer only (and Tiingo's free licence is internal use).
GOLDSCALP_HOST=127.0.0.1
GOLDSCALP_PORT=8000
# Phase 5 research service (monthly backtests) runs separately: python -m goldscalp.monthly
GOLDSCALP_MONTHLY_PORT=8001
# GOLDSCALP_DB_PATH=var/goldscalp.sqlite3
GOLDSCALP_MAX_IMPORT_MB=50

# --- Instrument (contract) specification -------------------------------------
# Every field must be stated in the file; nothing is assumed. The shipped file is a HYPOTHETICAL demo.
# GOLDSCALP_INSTRUMENT_SPEC=config/instruments/xauusd_demo.json

# --- Live market data ----------------------------------------------------------
# auto = first AVAILABLE provider in priority order: mt5 > tiingo (if a key is set) > gold-api > none.
# Options: auto | mt5 | tiingo | gold-api | none
GOLDSCALP_LIVE_PROVIDER=auto
# manual = never switch provider on failure (shows DISCONNECTED; use the dashboard to switch);
# auto   = switch to the next provider after the delay below, and back when the preferred one recovers.
# Every switch is shown on the dashboard with its time and reason.
GOLDSCALP_PROVIDER_FALLBACK=manual
GOLDSCALP_PROVIDER_FALLBACK_AFTER_SECONDS=30
# Timezone for DISPLAYING times in the browser (storage and calculations stay UTC). e.g. Europe/London
GOLDSCALP_DISPLAY_TIMEZONE=UTC

# --- MetaTrader 5 (optional, Windows only, READ-ONLY market data) --------------
# Install: pip install -r requirements-mt5.txt. Start MT5 and log in to your demo account first.
# There is deliberately NO login/password/server setting: GoldScalp never handles MT5 credentials.
GOLDSCALP_MT5_ENABLED=true
# Empty = detect the broker's gold symbol automatically (XAUUSD, XAUUSDm, GOLD, ...). Example: XAUUSD
GOLDSCALP_MT5_SYMBOL=
# MT5 times are the broker's SERVER clock. auto = detect from a fresh tick. Or: utc | fixed:+02:00 |
# rule:ny_close (UTC+2, UTC+3 in US summer - common) | tz:<IANA zone>. "UTC" is wrong for most brokers.
GOLDSCALP_MT5_TIME_BASIS=auto
GOLDSCALP_MT5_POLL_INTERVAL_SECONDS=1
# A tick older than this is not LIVE (shown as DELAYED)
GOLDSCALP_MT5_STALE_AFTER_SECONDS=10
# Only if several MT5 terminals are installed: full path of the one to use
GOLDSCALP_MT5_TERMINAL_PATH=
# true = never let GoldScalp start the terminal; it must already be running and logged in
GOLDSCALP_MT5_REQUIRE_RUNNING_TERMINAL=true
# true = add a hidden gold symbol to Market Watch so the terminal streams its ticks
GOLDSCALP_MT5_SELECT_SYMBOL=true
GOLDSCALP_MT5_INIT_TIMEOUT_MS=10000
# Phase 4: tell a DEMO server from a live one by reading ONLY the 'Server=' line of the terminal's own
# config/common.ini (no account data is read). false = environment shown as UNKNOWN.
GOLDSCALP_MT5_DETECT_ENVIRONMENT=true
# Bars downloaded per timeframe when the MT5 provider starts (deeper history helps research; limited by the
# terminal's "Max bars in chart" setting - a refused request falls back to the default depth).
GOLDSCALP_MT5_BACKFILL_BARS_M1=3000
GOLDSCALP_MT5_BACKFILL_BARS_M5=3000
GOLDSCALP_MT5_BACKFILL_BARS_M15=2000
GOLDSCALP_MT5_BACKFILL_BARS_H1=2000

# --- Tiingo (optional) ----------------------------------------------------------
# Free Tiingo DATA key (cannot trade). Real-time bid/ask stream -> LIVE. Licence: internal use only.
# Get one at https://www.tiingo.com (free "Starter" plan). Never commit it.
GOLDSCALP_TIINGO_API_KEY=
GOLDSCALP_TIINGO_TICKER=xauusd
GOLDSCALP_TIINGO_THRESHOLD_LEVEL=5
# Stop streaming (fall back to REST snapshots) after this much WebSocket data per process (MB).
GOLDSCALP_TIINGO_MONTHLY_STREAM_MB=700
# Request budget kept below Tiingo's free limits (50/hour, 1,000/day).
GOLDSCALP_TIINGO_REQUESTS_PER_HOUR=40
GOLDSCALP_TIINGO_REQUESTS_PER_DAY=800
# A real-time price older than this is shown as DELAYED; no contact for this long is DISCONNECTED.
GOLDSCALP_LIVE_WINDOW_SECONDS=15
GOLDSCALP_DISCONNECT_AFTER_SECONDS=180

# --- Live strategy evaluation (Phase 4, SIMULATED paper validation only) -------
GOLDSCALP_LIVE_MONITOR_ENABLED=true
# Signals and validation fills need a quote at most this old (seconds)
GOLDSCALP_LIVE_MAX_QUOTE_AGE_SECONDS=15
# History loaded for each as-of snapshot (the Strategy Lab's default lookback)
GOLDSCALP_LIVE_LOOKBACK_DAYS=5

# --- MT5 DEMO-account execution (optional, OFF by default) --------------------
# true = allow linking monitored strategy versions (Live page > Demo Execution) so their SIMULATED validation
# trades are ALSO placed as orders on the MT5 account your terminal is logged in to. Refused unless that account
# reports itself as a DEMO account (checked before every order) on a hedging account. Never real money.
# MT5 also needs its own "Algo Trading" button switched on.
GOLDSCALP_DEMO_EXECUTION_ENABLED=false
GOLDSCALP_DEMO_EXECUTION_MAX_LOTS=0.10
GOLDSCALP_DEMO_EXECUTION_MAX_POSITIONS=3
GOLDSCALP_DEMO_EXECUTION_MAX_ENTRY_DELAY_SECONDS=90
GOLDSCALP_DEMO_EXECUTION_DEVIATION_POINTS=30
GOLDSCALP_DEMO_EXECUTION_MAGIC=26111400

# --- Research assistant (Phase 4) ------------------------------------------------
# Default: deterministic answers computed locally from stored data. The optional Claude mode SENDS excerpts of
# stored GoldScalp data (signals, simulated trades, metrics) to Anthropic. It needs this switch, the 'anthropic'
# package (pip install -r requirements-ai.txt) and a key (here, or the SDK's own ANTHROPIC_API_KEY).
GOLDSCALP_ASSISTANT_LLM_ENABLED=false
GOLDSCALP_ASSISTANT_API_KEY=
GOLDSCALP_ASSISTANT_MODEL=claude-opus-5-5

# --- Paper-trading demonstration defaults (all hypothetical, change freely) ----
GOLDSCALP_PAPER_ACCOUNT_NAME=Demo paper account
GOLDSCALP_PAPER_STARTING_BALANCE=10000
# 1 means 1:1 (no leverage). Higher values are for educational simulation only.
GOLDSCALP_PAPER_LEVERAGE=1
# market | configured | market_else_configured (provider bid/ask when available, else the configured spread)
GOLDSCALP_PAPER_SPREAD_MODE=market_else_configured
# USD per troy ounce
GOLDSCALP_PAPER_CONFIGURED_SPREAD=0.30
# USD per 1.00 lot, charged when opening AND when closing
GOLDSCALP_PAPER_COMMISSION_PER_LOT_PER_SIDE=3.50
# USD per troy ounce, always against you, on every fill
GOLDSCALP_PAPER_SLIPPAGE=0.05
# Refuse simulated fills on prices older than this
GOLDSCALP_PAPER_MAX_QUOTE_AGE_SECONDS=90
# gold-api.com prices are DELAYED; set false to allow fills on LIVE prices only
GOLDSCALP_PAPER_ALLOW_DELAYED_FILLS=true

# --- Optional TradingView chart (display only; loads in your browser on click) --
GOLDSCALP_TRADINGVIEW_WIDGET=true
GOLDSCALP_TRADINGVIEW_SYMBOL=OANDA:XAUUSD
# true = stricter opaque-origin sandbox (not verified in every browser)
GOLDSCALP_TRADINGVIEW_SANDBOX=false

# --- Only if you expose the app beyond this computer (not recommended) ----------
# GOLDSCALP_AUTH_TOKEN=
